{
    "name": "tag-team-terror",
    "version": "1.0.0",
    "description": "Tag Team Terror: a monster tag-team brawler for the RUN October Jam",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "_build": "tsc --noEmit && vite build",
        "build": "npm run _build",
        "build:bundled": "cross-env RUNDOT_GAME_DISABLE_EMBEDDED_LIBS=true npm run _build",
        "preview": "vite preview",
        "deploy": "npm run build && rundot deploy"
    },
    "keywords": [
        "pixi",
        "react",
        "tailwind",
        "vite",
        "typescript",
        "game"
    ],
    "license": "SEE LICENSE IN LICENSE.txt",
    "allowScripts": {
        "@firebase/util": true,
        "@series-inc/rundot-game-sdk": true,
        "esbuild": true,
        "fsevents": true,
        "protobufjs": true
    },
    "dependencies": {
        "@series-inc/rundot-game-sdk": "5.29.1",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "three": "^0.186.1"
    },
    "devDependencies": {
        "@gltf-transform/core": "^4.5.1",
        "@gltf-transform/extensions": "^4.5.1",
        "@gltf-transform/functions": "^4.5.1",
        "@revenuecat/purchases-js": "^1.70.0",
        "@tailwindcss/vite": "^4.1.5",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@types/three": "^0.186.0",
        "@vitejs/plugin-react": "^4.4.1",
        "cross-env": "^7.0.3",
        "draco3dgltf": "^1.5.7",
        "firebase": "^12.16.0",
        "meshoptimizer": "^1.3.0",
        "sharp": "^0.35.5",
        "tailwindcss": "^4.1.5",
        "typescript": "^7.0.2",
        "vite": "^6.3.5"
    }
}
